# Variáveis para rodar a aplicação contra o PostgreSQL local (docker-compose.dev.yml).
# Copie para local-dev.env (ignorado pelo Git: *.env) e carregue com: set -a; source local-dev.env; set +a
DB_URL=jdbc:postgresql://127.0.0.1:55432/multisaude_dev
DB_USERNAME=multisaude_app
DB_PASSWORD=multisaude-app-dev-local
DB_MIGRATION_USERNAME=multisaude_migrator
DB_MIGRATION_PASSWORD=multisaude-migrator-dev-local
SERVER_PORT=8083
# Senha de todos os usuários de demonstração (mínimo 12 caracteres). Só vale para este banco local.
SEED_PASSWORD=demo-multisaude-2026
