# Copie pra .env.local (nunca commitar .env.local) e preencha com as chaves
# do SEU projeto Supabase. Nenhum valor aqui é real.
# Onde achar: supabase.com/dashboard/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Só no servidor — NUNCA prefixar com NEXT_PUBLIC_, NUNCA expor ao navegador.
# Usada só pelas duas rotas públicas sem login (totem, painel de TV) — ver
# nota de segurança em replica/backend.md.
SUPABASE_SERVICE_ROLE_KEY=

# Usada pro link de "esqueci minha senha" saber pra onde voltar. Em produção,
# o domínio real do app (ex.: https://sua-clinica.vercel.app).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
