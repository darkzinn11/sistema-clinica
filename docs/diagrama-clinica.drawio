        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n  CONTAS_FINANCEIRAS ||--o{ CAIXA_SESSOES : abre\n  LANCAMENTOS ||--|{ PARCELAS : divide\n  PARCELAS ||--o{ BAIXAS : recebe\n  CAIXA_SESSOES ||--o{ BAIXAS : registra\n  CATEGORIAS ||--o{ LANCAMENTOS : classifica\n  REGRAS_REPASSE ||--o{ REPASSE_ITENS : calcula\n  REPASSES ||--|{ REPASSE_ITENS : agrupa\n  LOTES_TISS ||--|{ GUIAS : contem\n  GUIAS ||--|{ GUIA_ITENS : lista\n  GUIA_ITENS ||--o{ GLOSAS : sofre\n  PRODUTOS ||--o{ LOTES_ESTOQUE : tem\n  LOTES_ESTOQUE ||--o{ MOVIMENTOS_ESTOQUE : movimenta\n  CONTAS_FINANCEIRAS { uuid id PK\n    uuid unidade_id FK\n    text tipo\n    text nome }\n  CAIXA_SESSOES { uuid id PK\n    uuid usuario_id FK\n    timestamptz aberto_em\n    timestamptz fechado_em\n    bigint saldo_informado }\n  CATEGORIAS { uuid id PK\n    uuid pai_id FK\n    text tipo\n    text nome }\n  LANCAMENTOS { uuid id PK\n    uuid tenant_id FK\n    text natureza\n    text origem_tipo\n    uuid origem_id\n    uuid paciente_id FK\n    bigint total_centavos }\n  PARCELAS { uuid id PK\n    int numero\n    date vencimento\n    bigint valor_centavos\n    text status }\n  BAIXAS { uuid id PK\n    text forma\n    bigint valor_centavos\n    bigint taxa_centavos\n    uuid estorno_de FK }\n  REGRAS_REPASSE { uuid id PK\n    uuid profissional_id FK\n    uuid procedimento_id FK\n    uuid convenio_id FK\n    text tipo\n    int percentual_bp\n    bigint fixo_centavos }\n  REPASSES { uuid id PK\n    uuid profissional_id FK\n    daterange competencia\n    text status }\n  REPASSE_ITENS { uuid id PK\n    uuid agendamento_item_id FK\n    bigint base_centavos\n    bigint valor_centavos }\n  LOTES_TISS { uuid id PK\n    uuid convenio_id FK\n    text versao_tiss\n    text status\n    bytea xml_hash }\n  GUIAS { uuid id PK\n    uuid atendimento_id FK\n    text tipo\n    text numero_operadora\n    text senha_autorizacao\n    text status }\n  GUIA_ITENS { uuid id PK\n    text codigo_tuss\n    int quantidade\n    bigint valor_centavos }\n  GLOSAS { uuid id PK\n    text codigo_motivo\n    bigint valor_centavos\n    text recurso_status }\n  PRODUTOS { uuid id PK\n    text nome\n    text unidade_medida\n    int estoque_minimo }\n  LOTES_ESTOQUE { uuid id PK\n    uuid unidade_id FK\n    text lote\n    date validade\n    numeric saldo }\n  MOVIMENTOS_ESTOQUE { bigint id PK\n    text tipo\n    numeric quantidade\n    text origem_tipo\n    uuid origem_id }&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="05f9hQZcFXm4TYZet_dT-1">
