        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n  PACIENTES ||--o{ PACIENTE_CONVENIOS : possui\n  PACIENTES ||--o{ CONSENTIMENTOS : assina\n  PROFISSIONAIS ||--o{ GRADES : define\n  PROFISSIONAIS ||--o{ BLOQUEIOS : tem\n  PACIENTES ||--o{ AGENDAMENTOS : marca\n  PROFISSIONAIS ||--o{ AGENDAMENTOS : atende\n  AGENDAMENTOS ||--|{ AGENDAMENTO_ITENS : contem\n  AGENDAMENTOS ||--o{ RESERVAS_RECURSO : bloqueia\n  AGENDAMENTOS ||--o{ STATUS_HISTORICO : registra\n  AGENDAMENTOS |o--o| SENHAS : gera\n  AGENDAMENTOS |o--o| ATENDIMENTOS : vira\n  ATENDIMENTOS ||--o{ REGISTROS_CLINICOS : produz\n  MODELOS_FORMULARIO ||--o{ REGISTROS_CLINICOS : estrutura\n  REGISTROS_CLINICOS |o--o{ REGISTROS_CLINICOS : substitui\n  ATENDIMENTOS ||--o{ PRESCRICOES : emite\n  PRESCRICOES ||--|{ PRESCRICAO_ITENS : lista\n  ATENDIMENTOS ||--o{ DOCUMENTOS : emite\n  PACIENTES ||--o{ ANEXOS : tem\n  PACIENTES { uuid id PK\n    uuid tenant_id FK\n    text nome\n    text nome_social\n    text cpf\n    date nascimento\n    text celular\n    uuid responsavel_id FK\n    jsonb extras }\n  PACIENTE_CONVENIOS { uuid id PK\n    uuid plano_id FK\n    text carteirinha\n    date validade }\n  CONSENTIMENTOS { uuid id PK\n    text finalidade\n    timestamptz aceito_em\n    timestamptz revogado_em }\n  GRADES { uuid id PK\n    uuid unidade_id FK\n    int dia_semana\n    time inicio\n    time fim\n    int intervalo_min\n    daterange vigencia }\n  BLOQUEIOS { uuid id PK\n    tstzrange periodo\n    text motivo }\n  AGENDAMENTOS { uuid id PK\n    uuid tenant_id FK\n    uuid unidade_id FK\n    uuid paciente_convenio_id FK\n    tstzrange periodo\n    text status\n    bool encaixe\n    uuid retorno_de FK\n    int versao }\n  AGENDAMENTO_ITENS { uuid id PK\n    uuid procedimento_id FK\n    bigint valor_centavos }\n  RESERVAS_RECURSO { uuid agendamento_id FK\n    text tipo_recurso\n    uuid recurso_id\n    tstzrange periodo }\n  STATUS_HISTORICO { bigint id PK\n    text de\n    text para\n    uuid usuario_id FK\n    timestamptz em }\n  SENHAS { uuid id PK\n    text prefixo\n    int numero\n    date dia\n    text status\n    uuid guiche_id }\n  ATENDIMENTOS { uuid id PK\n    timestamptz inicio\n    timestamptz fim\n    text status }\n  MODELOS_FORMULARIO { uuid id PK\n    text nome\n    int versao\n    jsonb schema }\n  REGISTROS_CLINICOS { uuid id PK\n    uuid substitui_id FK\n    jsonb conteudo\n    bytea hash\n    text assinatura\n    timestamptz assinado_em\n    text sigilo }\n  PRESCRICOES { uuid id PK\n    text tipo\n    text assinatura }\n  PRESCRICAO_ITENS { uuid id PK\n    text medicamento\n    text posologia }\n  DOCUMENTOS { uuid id PK\n    text tipo\n    text storage_key }\n  ANEXOS { uuid id PK\n    text storage_key\n    text mime\n    bigint bytes }&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="FGUbT--xmzG6dxEx3Jud-1">
