        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n  TENANTS ||--o{ UNIDADES : possui\n  USUARIOS ||--o{ SESSOES : abre\n  USUARIOS ||--o{ VINCULOS : tem\n  UNIDADES ||--o{ VINCULOS : em\n  PAPEIS ||--o{ VINCULOS : define\n  USUARIOS |o--o| PROFISSIONAIS : pode_ser\n  PROFISSIONAIS ||--o{ PROF_ESPECIALIDADES : tem\n  ESPECIALIDADES ||--o{ PROF_ESPECIALIDADES : em\n  PROFISSIONAIS ||--o{ PROF_UNIDADES : atua\n  UNIDADES ||--o{ PROF_UNIDADES : recebe\n  UNIDADES ||--o{ SALAS : tem\n  SALAS ||--o{ EQUIPAMENTOS : guarda\n  ESPECIALIDADES ||--o{ PROCEDIMENTOS : agrupa\n  CONVENIOS ||--o{ PLANOS_CONVENIO : oferece\n  TABELAS_PRECO ||--o{ PRECOS : lista\n  PROCEDIMENTOS ||--o{ PRECOS : precificado\n  CONVENIOS |o--o{ TABELAS_PRECO : usa\n  PROCEDIMENTOS ||--o{ PROC_RECURSOS : exige\n  TENANTS { uuid id PK\n    text nome\n    text plano\n    text status }\n  UNIDADES { uuid id PK\n    uuid tenant_id FK\n    text nome\n    text cnes\n    text fuso }\n  USUARIOS { uuid id PK\n    uuid tenant_id FK\n    citext email\n    text senha_hash\n    bool mfa_ativo\n    bool ativo }\n  SESSOES { uuid id PK\n    bytea token_hash\n    uuid unidade_ativa\n    timestamptz expira_em\n    timestamptz revogada_em }\n  PAPEIS { uuid id PK\n    uuid tenant_id FK\n    text nome\n    text_arr permissoes }\n  VINCULOS { uuid usuario_id FK\n    uuid unidade_id FK\n    uuid papel_id FK }\n  PROFISSIONAIS { uuid id PK\n    uuid tenant_id FK\n    uuid usuario_id FK\n    text conselho\n    text conselho_num\n    text conselho_uf\n    text cbo }\n  ESPECIALIDADES { uuid id PK\n    text nome\n    text cbo }\n  PROF_ESPECIALIDADES { uuid profissional_id FK\n    uuid especialidade_id FK }\n  PROF_UNIDADES { uuid profissional_id FK\n    uuid unidade_id FK }\n  SALAS { uuid id PK\n    uuid unidade_id FK\n    text nome }\n  EQUIPAMENTOS { uuid id PK\n    uuid sala_id FK\n    text nome }\n  PROCEDIMENTOS { uuid id PK\n    uuid tenant_id FK\n    text nome\n    text codigo_tuss\n    text tipo\n    int duracao_min }\n  PROC_RECURSOS { uuid procedimento_id FK\n    text tipo_recurso\n    uuid recurso_id }\n  CONVENIOS { uuid id PK\n    uuid tenant_id FK\n    text nome\n    text registro_ans\n    int prazo_retorno_dias }\n  PLANOS_CONVENIO { uuid id PK\n    uuid convenio_id FK\n    text nome }\n  TABELAS_PRECO { uuid id PK\n    uuid convenio_id FK\n    date vigencia_inicio\n    date vigencia_fim }\n  PRECOS { uuid tabela_id FK\n    uuid procedimento_id FK\n    bigint valor_centavos }&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="ivc_ezErEnRgJd-8g5Hq-1">
